# EventCore host profile — copy to ec/host.env and adjust. NEVER commit host.env.
# One place for everything that used to be rediscovered every release.

EC_REPO=/mnt/c/Users/bbgro/Downloads/eventspace-deploy
EC_HARNESS=/mnt/c/Users/bbgro/Downloads/eventcore-certification-harness
EC_DB=ec

# PostgreSQL. This host has no interactive password for `su postgres`;
# sudo -u is the working form. verify.sh consumes EC_PSQL via its own PSQL var.
EC_PSQL="sudo -u postgres psql"
EC_PSQL_ADMIN="sudo -u postgres"

# Linux Node. Plain `npm` can resolve to the Windows install from WSL.
EC_NODE=/usr/bin/node
EC_NPM_CLI=/usr/lib/node_modules/npm/bin/npm-cli.js

# Linux-only native binaries. The shared /mnt/c node_modules is NEVER touched
# by certification, so a WSL run cannot break the Windows build.
EC_TOOLING="$HOME/eventcore-tooling"
EC_PLAYWRIGHT_BROWSERS="$HOME/.cache/ms-playwright"

# App gates. `tsc` is pure JS and safe in WSL. `next build` pulls a
# platform-specific SWC binary, so it defaults to Windows/VS Code where your
# dependencies were installed. Values: tsc-wsl | all-wsl | skip
EC_APP_GATES=tsc-wsl
